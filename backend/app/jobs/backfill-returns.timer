[Unit]
Description=Run FinPilot forward-return backfill nightly at 06:00 UTC
Requires=backfill-returns.service

[Timer]
# 06:00 UTC — after US market close (21:00 ET prev day) + overnight settlement
OnCalendar=*-*-* 06:00:00 UTC

# If the machine was off at 06:00, run as soon as it comes back online
Persistent=true

# Small random delay to avoid stampede if multiple timers fire together
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
