[Unit]
Description=FinPilot nightly forward-return backfill
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# Adjust User and WorkingDirectory to match your deployment
User=finpilot
WorkingDirectory=/opt/finpilot

# Run inside the already-running api container so it shares the same Python env,
# DB credentials, and network as the application.
ExecStart=/usr/bin/docker compose exec -T api python -m app.jobs.backfill_returns

# Capture stdout/stderr to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finpilot-backfill

# Give it up to 20 minutes before the timer considers it timed out
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
