# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=finpilot
DB_PORT=5432

# ── Ports ────────────────────────────────────────────────────────────────────
API_PORT=8001
WEB_PORT=3010
# Address the published ports bind to. 127.0.0.1 keeps them local-only (put a
# reverse proxy or tunnel in front). Use 0.0.0.0 to expose them on the LAN.
BIND_HOST=127.0.0.1

# ── Backend ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# "production" disables the /docs and /redoc pages.
ENVIRONMENT=development

# Optional: Fernet key that encrypts the Gmail app password and Saxo access
# token at rest. Leave empty to store them in plaintext. Back it up: losing it
# means re-entering those values. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional: comma-separated hostnames that AI / search URLs may reach even
# though they resolve to private addresses (e.g. a local Ollama or SearXNG:
# "ollama,searxng"). All other user-supplied URLs must resolve to public IPs.
ALLOWED_PRIVATE_HOSTS=

# Comma-separated list of allowed CORS origins (space-free)
CORS_ORIGINS=http://localhost:3000,http://localhost:3010

# ── AI transaction categorization ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-haiku-4-5-20251001
