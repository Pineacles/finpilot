# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=finpilot
DB_PORT=5432

# ── Ports ────────────────────────────────────────────────────────────────────
API_PORT=8001
WEB_PORT=3010

# ── Backend ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins (space-free)
CORS_ORIGINS=http://localhost:3000,http://localhost:3010

# ── Access control ───────────────────────────────────────────────────────────
# Display name that may bypass tool-weight guardrails (leave blank to disable)
GUARDRAIL_ADMIN_NAME=

# Used by the frontend for audit-trail labels on proposal resolutions
NEXT_PUBLIC_ADMIN_NAME=admin

# ── Saxo Bank broker ─────────────────────────────────────────────────────────
SAXO_APP_KEY=
SAXO_APP_SECRET=
SAXO_CERT_PATH=
SAXO_ACCOUNT_KEY=

# ── Viseca One card sync ──────────────────────────────────────────────────────
VISECA_USERNAME=
VISECA_PASSWORD=

# ── AI analysis ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-sonnet-4-20250514
